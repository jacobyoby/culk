{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!.next",
      "!!out",
      "!!build",
      "!!coverage",
      "!!.vercel",
      "!!test-results",
      "!!playwright-report",
      "!!playwright/.cache",
      "!!.claude",
      "!!**/*.html",
      "!!**/*.css",
      "!!public/sw.js",
      "!!public/workbox-*.js",
      "!!public/worker-*.js",
      "!!public/icon.svg"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "warn"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
